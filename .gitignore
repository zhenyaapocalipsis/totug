# Godot cache (regenerated on import)
.godot/
*.import.tmp

# Built executables (rebuilt via build-*.bat)
*.exe
*.pck

# Python cache
__pycache__/
*.pyc

# OS junk
Thumbs.db
desktop.ini
GAME online/*.zip

# Build number, written by server/deploy.sh
engine/godot/build_info.gd
engine/godot/build_info.gd.uid
engine/build/version.txt
