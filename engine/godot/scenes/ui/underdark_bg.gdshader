shader_type canvas_item;

// Живой фон экрана: разлитая по тёмной воде краска Подземья.
//
// Как это устроено (порядок важен, каждый шаг отвечает за свою черту):
//
//   1. Вихрь. Координата пикселя поворачивается вокруг центра экрана тем
//      сильнее, чем дальше она от него: краска закручивается в спираль.
//   2. Шум fbm. Пятнистый шум из четырёх слоёв — от крупных пятен до мелкой
//      ряби. Он и даёт рваные края.
//   3. Двойное искажение. Шум считается не от самой координаты, а от
//      координаты, сдвинутой другим шумом, и так дважды. Именно от этого
//      появляются «пальцы» и завитки на краях языков.
//   4. Плоская краска. Языки выступают из темноты по порогу (gate), по самой
//      кромке идёт светлая полоска. Большая часть экрана остаётся почти
//      чёрной — иначе фон начинает спорить с интерфейсом.
//
// Пиксель-арт. Окно растягивает интерфейс (canvas_items), так что шейдер
// считается в полном разрешении окна; чтобы фон не был гладким, экран
// режется на клетки по pixel_size пикселей расчётного экрана 960x540, и
// каждая клетка красится одним цветом. Цвета плоские, без плавных
// переходов: кромки и затемнение к краям даются шахматным дизерингом
// (матрица Байера), а время идёт рывками по frame_rate кадров в секунду —
// как у нарисованной покадрово анимации.

/// Тёмная вода: занимает большую часть экрана.
uniform vec4 colour_1 : source_color = vec4(0.042, 0.024, 0.090, 1.0);
/// Первая краска — пурпур Подземья.
uniform vec4 colour_2 : source_color = vec4(0.400, 0.110, 0.700, 1.0);
/// Вторая краска — холодная бирюза.
uniform vec4 colour_3 : source_color = vec4(0.040, 0.450, 0.500, 1.0);
/// Куда гасится фон за игровым экраном (обычно цвет фона темы).
uniform vec4 fade_to : source_color = vec4(0.039, 0.023, 0.070, 1.0);
/// 0 — фон во всю силу (меню), 1 — полностью погашен в fade_to.
uniform float fade : hint_range(0.0, 1.0) = 0.0;
/// Скорость течения. Медленно: фон не должен тянуть взгляд на себя.
uniform float speed = 0.022;
/// Крупность рисунка: больше — мельче и гуще.
uniform float scale = 1.55;
/// Сила закрутки в спираль.
uniform float swirl = 2.4;
/// Сила искажения: насколько рваные края у языков.
uniform float warp = 2.6;
/// Сколько места занимают языки: выше — краски меньше, темноты больше.
uniform float ink : hint_range(0.0, 1.0) = 0.46;
/// Яркость блика на кромке.
uniform float glow : hint_range(0.0, 2.0) = 0.5;
/// Сила затемнения к краям экрана.
uniform float vignette : hint_range(0.0, 1.0) = 0.25;
/// Размер «пикселя» фона в пикселях расчётного экрана 960x540.
uniform float pixel_size = 1.0;
/// Высота расчётного экрана — от неё считается, сколько точек окна в клетке.
uniform float design_height = 540.0;
/// Сколько раз в секунду фон сдвигается: рывки, как у покадровой анимации.
uniform float frame_rate = 6.0;
/// Ширина полосы шахматки на кромке языка (в единицах поля 0..1).
uniform float dither : hint_range(0.0, 0.2) = 0.03;
/// Толщина светлой кромки (в единицах поля 0..1).
uniform float rim_width : hint_range(0.0, 0.1) = 0.018;


vec2 hash22(vec2 p) {
	p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
	return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}


/// Градиентный шум: в узлах решётки хранит направления, а не значения, и
/// поэтому не даёт уступов под 45 градусов. Сглаживание пятой степени —
/// у кубического на стыках клеток остаётся излом.
float gnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
	float a = dot(hash22(i + vec2(0.0, 0.0)), f - vec2(0.0, 0.0));
	float b = dot(hash22(i + vec2(1.0, 0.0)), f - vec2(1.0, 0.0));
	float c = dot(hash22(i + vec2(0.0, 1.0)), f - vec2(0.0, 1.0));
	float d = dot(hash22(i + vec2(1.0, 1.0)), f - vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}


/// Четыре слоя шума: крупные пятна плюс всё более мелкая рябь.
/// Результат приводится к 0..1 — по нему дальше ставятся пороги.
float fbm(vec2 p) {
	float sum = 0.0;
	float amp = 0.5;
	for (int i = 0; i < 4; i++) {
		sum += amp * gnoise(p);
		p = p * 2.03 + vec2(1.7, 9.2);
		amp *= 0.5;
	}
	return clamp(sum * 1.4 + 0.5, 0.0, 1.0);
}


/// Порог Байера 4x4 для клетки: 16 разных значений 0..1 в шахматном порядке.
float bayer2(vec2 c) {
	c = floor(c);
	return fract(dot(c, vec2(0.5, c.y * 0.75)));
}
float bayer4(vec2 c) {
	return bayer2(0.5 * c) * 0.25 + bayer2(c);
}


void fragment() {
	vec2 res = vec2(1.0) / SCREEN_PIXEL_SIZE;
	// Клетка фона: pixel_size пикселей расчётного экрана, целое число точек окна.
	float px = max(1.0, floor(res.y / design_height)) * max(pixel_size, 1.0);
	vec2 cell = floor(FRAGCOORD.xy / px);
	vec2 frag = cell * px + px * 0.5;
	// Координата от центра экрана, по короткой стороне — единица.
	vec2 uv = (frag - 0.5 * res) / min(res.x, res.y);
	float t = floor(TIME * frame_rate) / frame_rate * speed;
	float d = bayer4(cell) - 0.5;

	// 1. Вихрь: поворот тем больше, чем дальше от центра.
	float r = length(uv);
	float a = atan(uv.y, uv.x) + t * 0.6 - swirl * r;
	vec2 p = vec2(cos(a), sin(a)) * r * scale;

	// 2-3. Шум от шума от шума: края рвутся на пальцы и завитки.
	vec2 q = vec2(fbm(p + vec2(0.0, t)), fbm(p + vec2(5.2, 1.3 - t)));
	vec2 s = vec2(
		fbm(p + warp * q + vec2(1.7, 9.2) + 0.30 * t),
		fbm(p + warp * q + vec2(8.3, 2.8) - 0.25 * t)
	);
	// Два поля с одинаковым разбросом — по одному на каждую краску.
	float f1 = fbm(p + warp * s);
	float f2 = fbm(p + warp * s + vec2(4.4, 1.1));

	// 4. Языки краски выступают из темноты по порогу — без плавного
	// перехода: у кромки порог дрожит по матрице Байера, и край
	// рассыпается в шахматку, как у нарисованного вручную пиксель-арта.
	float gate = mix(0.42, 0.78, ink);
	float g1 = gate + d * dither;
	float g2 = gate + 0.04 + d * dither;
	float m1 = step(g1, f1);
	float m2 = step(g2, f2);

	vec3 col = colour_1.rgb;
	col = mix(col, colour_2.rgb, m1);
	// Где краски легли друг на друга — ровно середина, без лишних оттенков.
	col = mix(col, colour_3.rgb, m2 * (1.0 - m1 * 0.5));

	// Блик — светлая полоска по самой кромке языка.
	float rim = max(m1 * (1.0 - step(g1 + rim_width, f1)),
		m2 * (1.0 - step(g2 + rim_width, f2)));
	col += vec3(0.66, 0.56, 0.90) * rim * glow;

	// Края темнее — в центре экрана лежит доска. Затемнение ступенями
	// по четыре уровня, промежутки между ступенями — тоже шахматкой.
	float v = vignette * smoothstep(0.25, 1.1, r);
	v = floor(v * 4.0 + d + 0.5) / 4.0;
	col *= 1.0 - clamp(v, 0.0, 1.0);

	COLOR = vec4(mix(col, fade_to.rgb, fade), 1.0);
}
