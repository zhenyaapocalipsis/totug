shader_type canvas_item;

// Живой фон экрана: разлитая по тёмной воде краска Подземья.
//
// Как это устроено (порядок важен, каждый шаг отвечает за свою черту):
//
//   1. Вихрь. Координата пикселя поворачивается вокруг центра экрана тем
//      сильнее, чем дальше она от него: краска закручивается в спираль.
//   2. Шум fbm. Обычное мыльное пятно получается, если гнать координату
//      через синусы; здесь вместо этого пятнистый шум из пяти слоёв — от
//      крупных пятен до мелкой ряби. Он и даёт рваные края.
//   3. Двойное искажение. Шум считается не от самой координаты, а от
//      координаты, сдвинутой другим шумом, и так дважды. Именно от этого
//      появляются «пальцы» и завитки на краях языков — один проход даёт
//      только мягкие облака.
//   4. Плоская краска. Цвет не смешивается плавно: языки выступают из
//      темноты по порогу (gate) с узким переходом (edge), и по самой кромке
//      идёт светлый блик. Большая часть экрана остаётся почти чёрной —
//      иначе фон начинает спорить с интерфейсом.
//
// Экран рисуется в расчётном размере 640x360, поэтому один фрагмент шейдера —
// ровно один пиксель картинки: кромки получаются пиксельными, как и всё
// остальное в игре.

/// Тёмная вода: занимает большую часть экрана.
uniform vec4 colour_1 : source_color = vec4(0.042, 0.024, 0.090, 1.0);
/// Первая краска — пурпур Подземья.
uniform vec4 colour_2 : source_color = vec4(0.400, 0.110, 0.700, 1.0);
/// Вторая краска — холодная бирюза.
uniform vec4 colour_3 : source_color = vec4(0.040, 0.450, 0.500, 1.0);
/// Куда гасится фон за игровым экраном (обычно цвет фона темы).
uniform vec4 fade_to : source_color = vec4(0.039, 0.023, 0.070, 1.0);
/// 0 — фон во всю силу (меню), 1 — полностью погашен в fade_to.
uniform float fade : hint_range(0.0, 1.0) = 0.0;
/// Скорость течения. Медленно: фон не должен тянуть взгляд на себя.
uniform float speed = 0.062;
/// Крупность рисунка: больше — мельче и гуще.
uniform float scale = 1.55;
/// Сила закрутки в спираль.
uniform float swirl = 2.4;
/// Сила искажения: насколько рваные края у языков.
uniform float warp = 2.6;
/// Ширина перехода: маленькая — плоская краска с чёткой кромкой.
uniform float edge : hint_range(0.005, 0.30) = 0.045;
/// Сколько места занимают языки: выше — краски меньше, темноты больше.
uniform float ink : hint_range(0.0, 1.0) = 0.46;
/// Яркость блика на кромке.
uniform float glow : hint_range(0.0, 2.0) = 0.5;
/// Сила затемнения к краям экрана.
uniform float vignette : hint_range(0.0, 1.0) = 0.25;
/// Размер «пикселя» фона в пикселях экрана: 2-3 дают грубую пиксельную краску.
uniform float pixel_size = 1.0;


vec2 hash22(vec2 p) {
	p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
	return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}


/// Градиентный шум. Раньше здесь был шум попроще (значение в каждом узле
/// решётки): он дешевле, но его линии уровня липнут к осям решётки, и края
/// мазков выходят ступеньками под 45 градусов — та самая «лесенка».
/// Градиентный шум хранит в узлах направления, а не значения, и таких
/// уступов не даёт. Сглаживание тоже другое, пятой степени: у кубического
/// на стыках клеток остаётся излом.
float gnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
	float a = dot(hash22(i + vec2(0.0, 0.0)), f - vec2(0.0, 0.0));
	float b = dot(hash22(i + vec2(1.0, 0.0)), f - vec2(1.0, 0.0));
	float c = dot(hash22(i + vec2(0.0, 1.0)), f - vec2(0.0, 1.0));
	float d = dot(hash22(i + vec2(1.0, 1.0)), f - vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}


/// Четыре слоя шума: крупные пятна плюс всё более мелкая рябь.
/// Результат приводится к 0..1 — по нему дальше ставятся пороги.
float fbm(vec2 p) {
	float sum = 0.0;
	float amp = 0.5;
	for (int i = 0; i < 4; i++) {
		sum += amp * gnoise(p);
		p = p * 2.03 + vec2(1.7, 9.2);
		amp *= 0.5;
	}
	return clamp(sum * 1.4 + 0.5, 0.0, 1.0);
}


void fragment() {
	vec2 res = vec2(1.0) / SCREEN_PIXEL_SIZE;
	vec2 frag = FRAGCOORD.xy;
	if (pixel_size > 1.0) {
		frag = floor(frag / pixel_size) * pixel_size + pixel_size * 0.5;
	}
	// Координата от центра экрана, по короткой стороне — единица.
	vec2 uv = (frag - 0.5 * res) / min(res.x, res.y);
	float t = TIME * speed;

	// 1. Вихрь: поворот тем больше, чем дальше от центра.
	float r = length(uv);
	float a = atan(uv.y, uv.x) + t * 0.6 - swirl * r;
	vec2 p = vec2(cos(a), sin(a)) * r * scale;

	// 2-3. Шум от шума от шума: края рвутся на пальцы и завитки.
	vec2 q = vec2(fbm(p + vec2(0.0, t)), fbm(p + vec2(5.2, 1.3 - t)));
	vec2 s = vec2(
		fbm(p + warp * q + vec2(1.7, 9.2) + 0.30 * t),
		fbm(p + warp * q + vec2(8.3, 2.8) - 0.25 * t)
	);
	// Два поля с одинаковым разбросом — по одному на каждую краску.
	float f1 = fbm(p + warp * s);
	float f2 = fbm(p + warp * s + vec2(4.4, 1.1));

	// 4. Языки краски выступают из темноты по порогу.
	float gate = mix(0.42, 0.78, ink);
	// Ширина перехода — не уже, чем значение меняется от пикселя к пикселю
	// (fwidth). Фиксированный узкий порог рубит кромку ровно по границе
	// пикселей, и наклонный край рассыпается на ступеньки; здесь край всегда
	// размазан хотя бы на один пиксель и читается как линия, а не как лестница.
	float w1 = max(edge, fwidth(f1) * 1.6);
	float w2 = max(edge, fwidth(f2) * 1.6);
	float m1 = smoothstep(gate - w1, gate + w1, f1);
	// Вторая краска ложится реже первой: порог чуть выше.
	float m2 = smoothstep(gate + 0.04 - w2, gate + 0.04 + w2, f2);

	vec3 col = colour_1.rgb;
	col = mix(col, colour_2.rgb, m1);
	col = mix(col, colour_3.rgb, m2 * (1.0 - m1 * 0.55));

	// Блик — узкая светлая линия по самой кромке языка.
	float rim = (m1 - smoothstep(gate, gate + w1 * 2.4, f1))
		+ (m2 - smoothstep(gate + 0.04, gate + 0.04 + w2 * 2.4, f2));
	col += vec3(0.66, 0.56, 0.90) * rim * glow;

	// Края темнее — в центре экрана лежит доска, ей нужен спокойный фон.
	col *= 1.0 - vignette * smoothstep(0.25, 1.1, r);

	COLOR = vec4(mix(col, fade_to.rgb, fade), 1.0);
}
