shader_type canvas_item;

// Живой фон экрана: медленно текущие разводы Подземья.
//
// Никаких картинок: цвет каждого пикселя считается из его координаты и
// времени. Точка сначала закручивается вокруг центра экрана, потом её
// координата несколько раз подталкивается синусами (это и даёт «мраморные»
// разводы), а две волны по получившейся координате решают, какой из трёх
// цветов палитры здесь виден. Светлые кромки на границах волн — то, из-за
// чего фон выглядит текучим, а не просто размытым пятном.
//
// Экран рисуется в расчётном размере 640x360, поэтому один фрагмент шейдера —
// ровно один пиксель картинки: разводы получаются такими же пиксельными, как
// и всё остальное, без отдельной возни с квантованием.

uniform vec4 colour_1 : source_color = vec4(0.050, 0.030, 0.100, 1.0);
uniform vec4 colour_2 : source_color = vec4(0.330, 0.150, 0.640, 1.0);
uniform vec4 colour_3 : source_color = vec4(0.060, 0.440, 0.480, 1.0);
/// Куда гасится фон за игровым экраном (обычно цвет фона темы).
uniform vec4 fade_to : source_color = vec4(0.039, 0.023, 0.070, 1.0);
/// 0 — фон во всю силу (меню), 1 — полностью погашен в fade_to.
uniform float fade : hint_range(0.0, 1.0) = 0.0;
/// Скорость течения. Медленно: фон не должен тянуть взгляд на себя.
uniform float speed = 0.20;
/// Насколько крупные разводы: больше — мельче и гуще.
uniform float scale = 11.0;
/// Сила светлых кромок на границах разводов.
uniform float glow : hint_range(0.0, 1.0) = 0.35;
/// Сила затемнения к краям экрана.
uniform float vignette : hint_range(0.0, 1.0) = 0.40;

void fragment() {
	vec2 res = vec2(1.0) / SCREEN_PIXEL_SIZE;
	// Координата от центра экрана, по короткой стороне — единица.
	vec2 uv = (FRAGCOORD.xy - 0.5 * res) / min(res.x, res.y);
	float t = TIME * speed;

	// 1. Закрутка вокруг центра: чем дальше от него, тем сильнее поворот.
	float r = length(uv);
	float a = atan(uv.y, uv.x) + t * 0.25 + r * 2.2;
	vec2 p = vec2(cos(a), sin(a)) * r * scale;

	// 2. Разводы: несколько раз смещаем точку синусами от неё же самой.
	for (int i = 0; i < 6; i++) {
		float k = float(i);
		p += vec2(
			sin(p.y * 0.90 + t * 1.30 + k * 1.7),
			cos(p.x * 0.90 - t * 1.10 + k * 1.3)
		) * 1.15;
		p *= 1.06;
	}

	// 3. Две волны по искажённой координате делят экран на цветные ленты.
	float w1 = 0.5 + 0.5 * sin(p.x * 0.40 + p.y * 0.28 + t * 1.2);
	float w2 = 0.5 + 0.5 * cos(p.y * 0.34 - p.x * 0.22 - t * 0.9);
	vec3 col = mix(colour_1.rgb, colour_2.rgb, smoothstep(0.18, 0.86, w1));
	col = mix(col, colour_3.rgb, smoothstep(0.55, 0.98, w2));

	// 4. Светлые кромки там, где ленты сходятся.
	float edge = smoothstep(0.90, 1.0, w1) + smoothstep(0.93, 1.0, w2);
	col += colour_2.rgb * edge * glow;

	// 5. Края темнее — в центре экрана лежит доска, ей нужен спокойный фон.
	col *= 1.0 - vignette * smoothstep(0.15, 1.0, r);

	COLOR = vec4(mix(col, fade_to.rgb, fade), 1.0);
}
