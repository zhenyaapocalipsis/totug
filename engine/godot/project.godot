; Tyrants of the Underdark — Godot 4
; Ядро правил (core/) не имеет зависимостей от Node/сцен и запускается headless.

config_version=5

[application]

config/name="Tyrants of the Underdark"
config/features=PackedStringArray("4.7", "GDScript")
run/main_scene="res://scenes/launcher.tscn"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

; Игра рисуется в расчётном размере 960x540 — это настоящий пиксель-арт:
; каждый нарисованный пиксель виден на экране как квадрат, а stretch integer
; растягивает картинку только целым числом раз — пиксели не мылятся и не
; рвутся. На мониторе 1920x1080 картинка 960x540 укладывается ровно два раза
; (решение владельца, 2026-09-22: было 640x360 втрое, но экрану не хватало
; места), поэтому игра стартует во весь экран (mode=3), а F11 возвращает окно.
; Окно — в расчётный размер: вдвое больше него на 1080p в окно уже не влезет.
; Если масштаб не целый (2560x1440 = x2.67), автозагрузка SharpScale рисует игру
; в ближайший целый масштаб сверху и плавно уменьшает — без чёрных полос.
window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]

; Ближайший сосед: иначе пиксельные лица карт и шрифт замыливаются.
textures/canvas_textures/default_texture_filter=0

[autoload]

WindowKeys="*res://scenes/window_keys.gd"
SharpScale="*res://scenes/sharp_scale.gd"
SfxPlayer="*res://scenes/sfx.gd"
